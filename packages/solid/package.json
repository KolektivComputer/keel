{
  "name": "@kolektiv/keel-solid",
  "version": "0.0.2-SNAPSHOT.4",
  "description": "Keel Solid 1.9 bindings — Link, Form, Head, usePage, useForm, useAction.",
  "type": "module",
  "license": "Apache-2.0",
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "registry": "https://repo.yuri.capital/repository/keel-npm/"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./mount": {
      "types": "./dist/mount.d.ts",
      "import": "./dist/mount.js",
      "default": "./dist/mount.js"
    },
    "./bootstrap": {
      "types": "./dist/bootstrap.d.ts",
      "import": "./dist/bootstrap.js",
      "default": "./dist/bootstrap.js"
    }
  },
  "files": ["dist", "CHANGELOG.md"],
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "vite build && tsc -p tsconfig.build.json",
    "prepare": "pnpm build",
    "prepack": "node -e \"require('fs').copyFileSync(require('path').join('..','..','CHANGELOG.md'),'CHANGELOG.md')\"",
    "test": "pnpm build && node --conditions=browser --experimental-strip-types --test --test-force-exit test/*.test.ts"
  },
  "peerDependencies": {
    "@kolektiv/keel": "workspace:*",
    "@tanstack/solid-query": "^5.0.0",
    "solid-js": "^1.9.0"
  },
  "devDependencies": {
    "@kolektiv/keel": "workspace:*",
    "@tanstack/solid-query": "^5.66.0",
    "happy-dom": "^20.0.0",
    "solid-js": "^1.9.4",
    "typescript": "^5.7.0",
    "vite": "^6.2.0",
    "vite-plugin-solid": "^2.11.1"
  }
}
