{
  "name": "@kolektiv/keel-vue",
  "version": "0.1.0",
  "description": "Keel Vue 3 bindings — Link, Form, Head, usePage, useForm, useAction.",
  "type": "module",
  "license": "Apache-2.0",
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "registry": "https://repo.yuri.capital/repository/keel-npm/"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./mount": {
      "types": "./dist/mount.d.ts",
      "import": "./dist/mount.js",
      "default": "./dist/mount.js"
    },
    "./bootstrap": {
      "types": "./dist/bootstrap.d.ts",
      "import": "./dist/bootstrap.js",
      "default": "./dist/bootstrap.js"
    }
  },
  "files": ["dist", "CHANGELOG.md"],
  "scripts": {
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "build": "vite build && vue-tsc -p tsconfig.build.json",
    "prepare": "pnpm build",
    "prepack": "node -e \"require('fs').copyFileSync(require('path').join('..','..','CHANGELOG.md'),'CHANGELOG.md')\"",
    "test": "pnpm build && node --experimental-strip-types --test --test-force-exit test/*.test.ts"
  },
  "peerDependencies": {
    "@kolektiv/keel": "workspace:*",
    "@tanstack/vue-query": "^5.0.0",
    "vue": "^3.3.0"
  },
  "devDependencies": {
    "@kolektiv/keel": "workspace:*",
    "@tanstack/vue-query": "^5.66.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "happy-dom": "^20.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.2.0",
    "vue": "^3.5.13",
    "vue-tsc": "^2.2.0"
  }
}
