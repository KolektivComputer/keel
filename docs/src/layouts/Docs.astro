---
import DocsLayout from "@kolektiv/common-docs-chrome/astro/DocsLayout.astro"
import KeelBehavior from "../components/KeelBehavior.astro"
import { docs } from "../docs-chrome"
import { allDocs } from "../lib/docs"
import { navFromEntries } from "../lib/nav"
import { path } from "../lib/paths"
import "../styles/global.css"

interface Props {
  title: string
  description: string
}

const { title, description } = Astro.props
const entries = await allDocs()
const config = { ...docs, nav: navFromEntries(entries) }
const previewPaths = [
  path("/"),
  path("/docs"),
  ...entries.map((entry) => path(`/docs/${entry.id}`)),
]
---

<DocsLayout config={config} title={title} description={description} currentPath={Astro.url.pathname}>
  <slot />
  <KeelBehavior previewPaths={previewPaths} />
</DocsLayout>
