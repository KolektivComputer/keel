---
import BaseLayout from "@kolektiv/common-docs-chrome/astro/BaseLayout.astro"
import type { NavbarConfig } from "@kolektiv/common-docs-chrome"
import KeelBehavior from "../components/KeelBehavior.astro"
import { docs } from "../docs-chrome"
import { allDocs } from "../lib/docs"
import { path } from "../lib/paths"
import "../styles/global.css"

interface Props {
  title?: string
  description?: string
  navbar?: Partial<NavbarConfig>
}

const {
  title = "Keel",
  description = "Host-owned routing and render-time frontend packs for Kotlin servers. Svelte, React, Vue, Solid, Preact, Lit, and Angular adapters.",
  navbar,
} = Astro.props

const entries = await allDocs()
const previewPaths = [
  path("/"),
  path("/docs"),
  ...entries.map((entry) => path(`/docs/${entry.id}`)),
]
---

<BaseLayout config={docs} title={title} description={description} navbar={navbar}>
  <slot />
  <KeelBehavior previewPaths={previewPaths} />
</BaseLayout>
