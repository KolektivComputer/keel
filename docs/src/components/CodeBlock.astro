---
import ShikiCode from "./ShikiCode.astro"

interface FrameworkOption {
  id: string
  label: string
  title?: string
  lang?: string
  code?: string
  ts?: string
  js?: string
}

interface Props {
  code?: string
  lang?: string
  title?: string
  fw?: string
  bw?: string
  frameworks?: FrameworkOption[]
  /**
   * Generic chrome switcher id. When set (e.g. "gradle"), panels are emitted as
   * `data-<switcher>-panel` instead of `data-framework-panel`, so the framework
   * dropdown is not triggered and the named chrome switcher drives them.
   */
  switcher?: string
}

const { code = "", lang = "ts", title, fw = "all", bw = "all", frameworks, switcher } = Astro.props
const hasFrameworks = Boolean(frameworks?.length)
const defaultFramework = frameworks?.[0]?.id ?? "svelte"
const panelAttrs = (id: string) =>
  switcher ? { [`data-${switcher}-panel`]: id } : { "data-framework-panel": id }
---

<figure
  class="keel-code not-prose my-5 overflow-hidden rounded-box border-2 border-base-300"
  data-fw={fw}
  data-bw={bw}
  data-framework={!switcher && hasFrameworks ? defaultFramework : undefined}
>
  <figcaption class="flex items-center justify-between gap-2 border-b-2 border-base-300 bg-base-200 px-3 py-2">
    <span class="truncate font-mono text-xs tracking-wide opacity-80">{title ?? lang}</span>
    <div class="flex items-center gap-1">
      <button type="button" class="btn btn-ghost btn-xs" data-copy>Copy</button>
    </div>
  </figcaption>
  {
    hasFrameworks ? (
      frameworks!.map((item) => (
        <div {...panelAttrs(item.id)}>
          {item.ts ? (
            <div class="keel-code">
              <div data-lang-panel="ts">
                <ShikiCode code={item.ts} lang="ts" />
              </div>
              <div data-lang-panel="js">
                <ShikiCode code={item.js ?? item.ts} lang="js" />
              </div>
            </div>
          ) : (
            <ShikiCode code={item.code ?? ""} lang={item.lang ?? "ts"} />
          )}
        </div>
      ))
    ) : (
      <ShikiCode code={code} lang={lang} />
    )
  }
</figure>
