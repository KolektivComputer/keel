---
import ShikiCode from "./ShikiCode.astro"

interface FileSnippet {
  title: string
  lang?: "ts" | "tsx" | "js" | "jsx" | "kotlin" | "json" | "bash" | "vue" | "svelte" | "html"
  code?: string
  ts?: string
  js?: string
}

interface FrameworkGroup {
  id: string
  label: string
  files: FileSnippet[]
}

interface Props {
  frameworks: FrameworkGroup[]
  overlay?: boolean
}

const { frameworks, overlay = false } = Astro.props
---

<div
  class:list={[
    "keel-deck overflow-hidden rounded-box border-2 border-base-300 bg-base-100",
    overlay && "keel-deck-overlay",
  ]}
  data-file="0"
>
  {
    !overlay && (
      <div class="flex items-center gap-2 border-b-2 border-base-300 bg-base-200 px-3 py-2">
        <div class="ml-auto flex items-center gap-1">
          <button type="button" class="btn btn-ghost btn-xs min-h-8" data-copy>
            Copy
          </button>
        </div>
      </div>
    )
  }
  {
    frameworks.map((group) => (
      <div data-framework-panel={group.id}>
        <div class="flex flex-wrap items-center gap-2 border-b-2 border-base-300 bg-base-200 px-3 py-2">
          <div class="join" role="tablist" aria-label={`${group.label} files`}>
            {group.files.map((file, index) => (
              <button
                type="button"
                role="tab"
                class:list={[
                  "btn join-item min-h-11 lg:btn-xs lg:min-h-8",
                  index === 0 && "btn-active",
                ]}
                data-file-btn={String(index)}
                aria-selected={index === 0 ? "true" : "false"}
              >
                {file.title}
              </button>
            ))}
          </div>
          {overlay && (
            <div class="ml-auto hidden items-center gap-1 lg:flex">
              <button type="button" class="btn btn-ghost min-h-11 lg:btn-xs lg:min-h-8" data-copy>
                Copy
              </button>
              <button
                type="button"
                class="btn btn-ghost btn-square min-h-11 min-w-11 lg:btn-xs lg:min-h-8 lg:min-w-8"
                data-code-hide
                aria-label="Hide code"
                aria-expanded="true"
                aria-controls="keel-hero-code"
              >
                <svg viewBox="0 0 24 24" class="size-4" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden>
                  <path d="M6 6l12 12M18 6L6 18"></path>
                </svg>
              </button>
            </div>
          )}
        </div>
        {group.files.map((file, index) => (
          <div data-file-panel={String(index)} class="keel-code">
            {file.ts ? (
              <>
                <div data-lang-panel="ts" class:list={[overlay && "overflow-auto lg:h-36"]}>
                  <ShikiCode code={file.ts} lang="ts" />
                </div>
                <div data-lang-panel="js" class:list={[overlay && "overflow-auto lg:h-36"]}>
                  <ShikiCode code={file.js ?? file.ts} lang="js" />
                </div>
              </>
            ) : (
              <div class:list={[overlay && "overflow-auto lg:h-36"]}>
                <ShikiCode code={file.code ?? ""} lang={file.lang ?? "ts"} />
              </div>
            )}
          </div>
        ))}
      </div>
    ))
  }
</div>
