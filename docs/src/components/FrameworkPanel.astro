---
/**
 * Gate docs prose/callouts on the shared chrome FrameworkPicker
 * (`kdc:framework`, mirrored to `data-frontend`).
 * Uses Keel's html[data-framework]/[data-fw] CSS (same as CodeBlock).
 * Provide a Svelte panel as the fallback when a topic has no other coverage.
 */
interface Props {
  /** One or more framework ids, space-separated (e.g. "react preact"), or "all". */
  frameworks: string
}
const { frameworks } = Astro.props
---

<div data-fw={frameworks}>
  <slot />
</div>
