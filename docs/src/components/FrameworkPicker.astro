---
import { FRAMEWORKS } from "../lib/prefs"

const id = "keel-frontend-pop"
const anchor = "--keel-frontend"
---

<button
  type="button"
  class="btn btn-ghost btn-sm min-h-11 gap-2 px-3"
  popovertarget={id}
  style={`anchor-name:${anchor}`}
  aria-label="Frontend framework"
  title="Frontend framework"
>
  <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden>
    <path d="M4 6h16M4 12h16M4 18h10" stroke-linecap="round"></path>
  </svg>
  <span data-frontend-current class="hidden sm:inline">Svelte</span>
</button>
<div
  popover
  id={id}
  class="dropdown dropdown-end dropdown-bottom bg-base-100 rounded-box w-56 border-2 border-base-300 p-2 shadow-lg"
  style={`position-anchor:${anchor}`}
>
  <ul class="menu menu-sm w-full p-0">
    <li class="menu-title">Frontend framework</li>
    {
      FRAMEWORKS.map((framework) => (
        <li>
          <label class="flex cursor-pointer items-center gap-2">
            <input
              type="radio"
              name="keel-frontend"
              class="radio radio-xs radio-primary"
              data-pref="frontend"
              value={framework.id}
            />
            <span>{framework.label}</span>
            <span class="ml-auto font-mono text-[0.65rem] opacity-50">{framework.pkg.replace("@kolektiv/keel-", "")}</span>
          </label>
        </li>
      ))
    }
    <li class="menu-title mt-2 font-normal normal-case tracking-normal opacity-60">
      Snippets and docs panels without this framework fall back to Svelte.
    </li>
  </ul>
</div>
