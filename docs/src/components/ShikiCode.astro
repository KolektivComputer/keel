---
import { Code } from "astro:components"
import { createShikiConfig } from "@kolektiv/common-docs-chrome"

interface Props {
  code: string
  lang?: string
}

const { code, lang = "ts" } = Astro.props
const shikiThemes = createShikiConfig().themes
---

<Code
  code={code}
  lang={lang as "ts"}
  themes={shikiThemes}
  defaultColor={false}
  wrap
/>
